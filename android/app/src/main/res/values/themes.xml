<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- DayNight: the WebView passes the app's light/dark to the page as
         prefers-color-scheme, so Burrow's "auto" theme follows the phone. -->
    <style name="Theme.Burrow" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/background</item>
        <!-- The app's own questions (a download, a sign-in, confirm()) light or
             dark as the app, buttons as written (A3-AND-23). -->
        <item name="alertDialogTheme">@style/Theme.Burrow.Dialog</item>
    </style>

    <style name="Theme.Burrow.Dialog" parent="Theme.AppCompat.DayNight.Dialog.Alert">
        <item name="colorAccent">@color/accent</item>
        <item name="colorPrimary">@color/accent</item>
        <item name="buttonBarButtonStyle">@style/Burrow.DialogButton</item>
    </style>

    <style name="Burrow.DialogButton" parent="Widget.AppCompat.Button.ButtonBar.AlertDialog">
        <item name="android:textAllCaps">false</item>
        <item name="textAllCaps">false</item>
    </style>
</resources>
