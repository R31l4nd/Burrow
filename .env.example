# Copy to .env and adjust. Only BURROW_ORIGIN is required.

# The URL you open Burrow on. Passkeys are bound to this hostname, so pick it
# once: changing it later means registering passkeys again.
BURROW_ORIGIN=https://burrow.home.example.com

# Where Burrow keeps its database and master key. A named volume by default;
# set a host path for a bind mount instead, e.g. /srv/burrow, made first and
# owned by uid 1000 (sudo mkdir -p /srv/burrow && sudo chown 1000:1000 /srv/burrow):
# a folder Docker makes is root's, and Burrow cannot write it.
BURROW_DATA=burrow-data

# Optional: the master key that encrypts stored SSH keys and passwords. Leave
# empty and Burrow generates one in the data directory (secret.key, 0600).
# Whichever you use: back it up. Without it the stored secrets are lost.
# A value here shows in docker inspect; docs/DEPLOY.md has it as a file.
BURROW_SECRET=

# !! Set this when Burrow is behind a reverse proxy (the normal setup) !!
# The proxy's address as Burrow sees it, an IP or CIDR (comma separated for
# more): the proxy network's subnet is the usual choice,
#   docker network inspect proxy -f '{{(index .IPAM.Config 0).Subnet}}'
# (with your PROXY_NETWORK in place of "proxy"). Left empty behind a proxy,
# every request seems to come from the proxy: the sign-in throttle then
# counts all your devices as one, so ten wrong attempts from any of them
# block sign-in for everyone for 15 minutes, and the audit log shows only
# the proxy's address. Empty is right only without a proxy ("Just trying
# it" in docs/INSTALL.md).
TRUST_PROXY=

# Docker network that your reverse proxy (SWAG, Traefik, Caddy...) is on.
# Burrow publishes no port by default; the proxy reaches it over this network.
PROXY_NETWORK=proxy

# SWAG with swag-auto-proxy only (other proxies ignore this): enable to let
# SWAG pick Burrow up from its labels. Off by default, because most SWAGs
# face the internet and Burrow must not: first make SWAG serve SWAG_URL to
# your LAN or VPN only (docs/INSTALL.md, "SWAG").
#SWAG_ENABLE=enable
# The hostname pattern SWAG serves Burrow on.
SWAG_URL=burrow.local.*

LOG_LEVEL=info

# Terminal: most sessions open at once, and minutes after which a session
# nobody watches is closed (0 = never). These two, the online check below,
# UPDATE_CHECK_EXCLUDE, REGISTRY_ENDPOINTS and APPS_BASE_DOMAIN can also be set
# in Settings -> System; a value set there goes before the one here.
TERMINAL_MAX_SESSIONS=20
TERMINAL_IDLE_MINUTES=0

# How often each host's SSH port is tried for its online dot, in seconds (0 = off).
#STATUS_INTERVAL_SECONDS=60

# Limits, so Burrow cannot starve this machine: memory, processes, and the
# size of its /tmp (memory as well).
#BURROW_MEM_LIMIT=2g
#BURROW_PIDS_LIMIT=512
#BURROW_TMP_SIZE=256m

# --- Backups (optional) -------------------------------------------------
# COMPOSE_PROFILES=backup starts the backup container next to Burrow.
# Create the key first: see secrets/README.md.
#COMPOSE_PROFILES=backup
BACKUP_DIR=./backups
BACKUP_INTERVAL_SECONDS=86400
# Kept: every backup younger than BACKUP_RETENTION_DAYS, but at most the
# newest BACKUP_RETENTION_MAX (every deploy, update and "Back up now" adds a
# round), and always the newest BACKUP_RETENTION_COUNT whatever their age
# (also when rounds fail), never more than MAX. COUNT 0 keeps everything;
# DAYS 0 counts only; MAX 0 caps nothing.
BACKUP_RETENTION_COUNT=30
BACKUP_RETENTION_DAYS=30
BACKUP_RETENTION_MAX=60
# A second copy on another disk, verified after copying.
BACKUP_REMOTE_ENABLED=0
#BACKUP_REMOTE_DIR=/mnt/other-disk/burrow-backups
