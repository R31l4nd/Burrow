# Burrow - copy to .env.build and fill in. Only for `make apk`.
#
# Kept apart from .env on purpose: .env goes to the server container, and a
# signing key's password does not belong there; the build container in turn
# has no business with the server's secrets.
#
# Password of the signing key in android/keystore/burrow.jks (made by
# `make apk-keystore`). Generate with: openssl rand -base64 24
KEYSTORE_PASSWORD=
